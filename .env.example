# OpenAI (required for resume / cover letter / form answers)
OPENAI_API_KEY=sk-your-key-here

# Resume + cover letter model. The Model menu in the panel overrides this.
# OPENAI_MODEL=gpt-5.6-luna

# Form classify + autofill answers (cheap/fast). Defaults to gpt-4o-mini
# OPENAI_FORM_MODEL=gpt-4o-mini
