{
  "manifest_version": 3,
  "name": "Resume GPT Builder",
  "description": "Generate tailored resumes and cover letters via the OpenAI API, then render PDFs.",
  "version": "1.2.0",
  "permissions": ["storage", "downloads", "clipboardRead", "tabs", "debugger"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/j-icon.svg",
    "32": "icons/j-icon.svg",
    "48": "icons/j-icon.svg",
    "128": "icons/j-icon.svg"
  },
  "action": {
    "default_title": "Resume GPT Builder (Ctrl+Shift+Z)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/j-icon.svg",
      "32": "icons/j-icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Open Resume GPT Builder"
    }
  }
}
