{
  "manifest_version": 3,
  "name": "Resume GPT Builder",
  "description": "Generate tailored resumes and cover letters via the OpenAI API, then autofill job applications.",
  "version": "1.4.1",
  "permissions": ["storage", "downloads", "clipboardRead", "tabs", "scripting", "debugger", "notifications"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://*.indeed.com/*",
        "https://indeed.com/*",
        "https://www.dice.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.wd1.myworkdayjobs.com/*",
        "https://*.wd5.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.bamboohr.com/*",
        "https://*.ashbyhq.com/*"
      ],
      "js": ["content/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/j-icon.svg",
    "32": "icons/j-icon.svg",
    "48": "icons/j-icon.svg",
    "128": "icons/j-icon.svg"
  },
  "action": {
    "default_title": "Resume GPT Builder (Ctrl+Shift+G)",
    "default_icon": {
      "16": "icons/j-icon.svg",
      "32": "icons/j-icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open Resume GPT Builder"
    }
  }
}
