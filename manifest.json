{
  "manifest_version": 3,
  "name": "Resume GPT Builder",
  "description": "Generate tailored resumes and cover letters via the OpenAI API, then autofill job applications.",
  "version": "1.6.1",
  "permissions": ["storage", "downloads", "clipboardRead", "tabs", "scripting", "debugger", "notifications", "alarms"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://*.indeed.com/*",
        "https://indeed.com/*",
        "https://www.dice.com/*",
        "https://*.dice.com/*",
        "https://jobright.ai/*",
        "https://*.jobright.ai/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.wd1.myworkdayjobs.com/*",
        "https://*.wd5.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.bamboohr.com/*",
        "https://*.ashbyhq.com/*"
      ],
      "js": ["content/autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/j-icon.svg",
    "32": "icons/j-icon.svg",
    "48": "icons/j-icon.svg",
    "128": "icons/j-icon.svg"
  },
  "action": {
    "default_title": "Resume GPT Builder (Alt+J)",
    "default_icon": {
      "16": "icons/j-icon.svg",
      "32": "icons/j-icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Open Resume GPT Builder panel"
    },
    "scrape_and_apply": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Scrape open job → generate → Easy Apply"
    },
    "generate_docs": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Generate resume (and cover letter unless resume-only)"
    },
    "easy_apply": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Easy Apply on current Dice/Jobright page"
    }
  }
}
